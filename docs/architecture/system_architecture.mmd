flowchart LR
  classDef source fill:#E8F1FF,stroke:#2563EB,color:#10213B,stroke-width:1.5px;
  classDef ingest fill:#FFF4D6,stroke:#D97706,color:#3B2600,stroke-width:1.5px;
  classDef storage fill:#E8F7EE,stroke:#16803C,color:#12351F,stroke-width:1.5px;
  classDef process fill:#F1ECFF,stroke:#7048C8,color:#27164D,stroke-width:1.5px;
  classDef serving fill:#E9F7F7,stroke:#087F8C,color:#12383B,stroke-width:1.5px;
  classDef ops fill:#FCEAEC,stroke:#C43B55,color:#4A1620,stroke-width:1.5px;
  classDef observe fill:#F2F4F7,stroke:#64748B,color:#263244,stroke-width:1.5px;

  subgraph SOURCES[NGUỒN DỮ LIỆU]
    direction TB
    KBS["API Chứng khoán (vnstock)<br/>Dữ liệu Giao dịch & Doanh nghiệp"]:::source
    VCI["API Chỉ số (vnstock)<br/>VNINDEX, VN30"]:::source
    NEWS[Tin tức Tài chính<br/>VnExpress, Vietstock, CafeF]:::source
    DNSE["WebSocket (DNSE)<br/>Dữ liệu thời gian thực (Tick, 1m)"]:::source
  end

  subgraph BATCH[LUỒNG BATCH]
    direction TB
    AIRFLOW["Apache Airflow<br/>Điều phối luồng dữ liệu (Orchestration)"]:::ingest
    CRAWLER[Module Thu thập Dữ liệu<br/>Tự động hóa lấy tin tức]:::ingest
    BRONZE[("MinIO Bronze Layer<br/>Lưu trữ dữ liệu thô")]:::storage
    SILVER[("MinIO Silver Layer<br/>Dữ liệu đã làm sạch & chuẩn hóa")]:::storage
    TRANSFORM["Data Processing (Polars)<br/>Biến đổi và Khử trùng lặp"]:::process
    QUALITY[Kiểm định Chất lượng<br/>Quality Gate Python tự xây]:::process
    DBT["Data Transformation (dbt)<br/>Tính toán các chỉ báo kỹ thuật"]:::process
    NLP[Dịch vụ AI/NLP<br/>Nhận diện thực thể & Cảm xúc]:::process
  end

  subgraph STREAM[LUỒNG REALTIME]
    direction TB
    PRODUCER[Kafka Producer<br/>Tiếp nhận dữ liệu thời gian thực]:::ingest
    KAFKA[("Apache Kafka<br/>Message Broker")]:::storage
    ZK[Zookeeper<br/>Quản lý cụm Kafka]:::observe
    KENGINE[ClickHouse Kafka Engine<br/>Xử lý dòng dữ liệu]:::process
    RAWTICK[("Bảng dữ liệu Tick thô<br/>realtime_trade_ticks_raw")]:::storage
    VWAPSTATE[("Bảng trạng thái VWAP<br/>fact_realtime_vwap_1m_state")]:::storage
    INTRADAY[("Bảng Nến giao dịch<br/>fact_intraday_ohlcv")]:::storage
    VWAPVIEW[Khung nhìn VWAP<br/>Chỉ số trung bình giá theo KL]:::serving
  end

  subgraph LAKE_SERVE[LAKEHOUSE VÀ SERVING]
    direction TB
    CLICKHOUSE[("ClickHouse - Gold Layer<br/>Kho dữ liệu phân tích tốc độ cao")]:::serving
    GOLD[("MinIO Gold Layer<br/>Lưu trữ Parquet định kỳ")]:::storage
    BACKUP[("MinIO Backup<br/>Bản sao dự phòng hệ thống")]:::storage
    POSTGRES[("PostgreSQL<br/>Cấu hình Cảnh báo & Danh mục")]:::ops
  end

  subgraph CONSUME[PHỤC VỤ VÀ CẢNH BÁO]
    direction TB
    API["RESTful API (FastAPI)<br/>Cung cấp dữ liệu hệ thống"]:::serving
    REACT["Giao diện Người dùng (React)<br/>Bảng điều khiển Thị trường"]:::serving
    SUPERSET[Apache Superset<br/>Báo cáo & Phân tích BI]:::observe
    GRAFANA[Grafana<br/>Giám sát sức khỏe Hệ thống]:::observe
    ALERT[Hệ thống Cảnh báo tự động<br/>Alert Engine]:::ops
    CHANNEL[Kênh Thông báo<br/>Telegram & Email]:::ops
    SLACK[Thông báo vận hành<br/>Slack Webhook]:::ops
  end

  KBS --> AIRFLOW
  VCI --> AIRFLOW
  NEWS --> CRAWLER --> BRONZE
  AIRFLOW --> BRONZE
  BRONZE --> TRANSFORM --> SILVER --> QUALITY
  QUALITY --> CLICKHOUSE
  CLICKHOUSE --> DBT --> CLICKHOUSE
  SILVER -. Tin đã liên kết .-> NLP -. Sentiment Gold .-> CLICKHOUSE
  CLICKHOUSE -->|Xuất Parquet| GOLD --> BACKUP

  DNSE --> PRODUCER --> KAFKA --> KENGINE
  ZK -. Điều phối broker .-> KAFKA
  KENGINE --> RAWTICK
  KENGINE --> VWAPSTATE --> VWAPVIEW --> CLICKHOUSE
  KENGINE --> INTRADAY --> CLICKHOUSE

  CLICKHOUSE --> API
  POSTGRES --> API
  API --> REACT
  CLICKHOUSE --> SUPERSET
  CLICKHOUSE --> GRAFANA
  CLICKHOUSE --> ALERT
  POSTGRES --> ALERT --> CHANNEL
  AIRFLOW -. Trạng thái DAG .-> API
  AIRFLOW -. DAG thành công hoặc lỗi .-> SLACK
  PRODUCER -. Backup Parquet tick và nến .-> BACKUP
  KAFKA -. Lag .-> GRAFANA

