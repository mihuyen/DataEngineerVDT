%%{init: {"theme":"base","htmlLabels":false,"flowchart":{"htmlLabels":false,"curve":"basis","nodeSpacing":16,"rankSpacing":24,"diagramPadding":6},"themeVariables":{"background":"#ffffff","primaryTextColor":"#172033","lineColor":"#64748b","clusterBkg":"#f8fafc","clusterBorder":"#94a3b8","edgeLabelBackground":"#ffffff","fontFamily":"Arial"}}}%%
flowchart TB
  classDef kafka fill:#FFF4D6,stroke:#D97706,color:#3B2600,stroke-width:1.5px;
  classDef batch fill:#E8F7EE,stroke:#16803C,color:#12351F,stroke-width:1.5px;
  classDef stream fill:#E8F1FF,stroke:#2563EB,color:#10213B,stroke-width:1.5px;
  classDef view fill:#F1ECFF,stroke:#7048C8,color:#27164D,stroke-width:1.5px;
  classDef pg fill:#FCEAEC,stroke:#C43B55,color:#4A1620,stroke-width:1.5px;
  classDef app fill:#F2F4F7,stroke:#64748B,color:#263244,stroke-width:1.5px;
  classDef future fill:#FFFFFF,stroke:#7C3AED,color:#3B1D70,stroke-width:1.5px,stroke-dasharray:5 4;

  subgraph BUS[KAFKA]
    direction LR
    T1[Chủ đề: dnse-trades-raw<br/>Định dạng JSON]:::kafka
    T2[Chủ đề: dnse-ohlcv-1m<br/>Định dạng JSON]:::kafka
  end

  subgraph CH[CLICKHOUSE - DATABASE stock_lakehouse]
    direction TB

    subgraph CHDIM[DIMENSION TABLES]
      direction LR
      D1[dim_date<br/>MergeTree; ORDER date_id]:::batch
      D2[dim_stock<br/>MergeTree; ORDER ticker]:::batch
      D3[dim_sector<br/>MergeTree; ORDER sector_id]:::batch
      D4[dim_index<br/>MergeTree; ORDER index_id]:::batch
    end

    subgraph CHBATCH[BATCH FACT TABLES]
      direction LR
      F1[fact_daily_price<br/>MergeTree; partition tháng<br/>ORDER ticker, trading_date]:::batch
      F2[fact_market_index<br/>MergeTree; partition tháng<br/>ORDER index_id, trading_date]:::batch
      F5[fact_news_sentiment_detail<br/>ReplacingMergeTree; partition tháng<br/>ORDER ticker, published_at, article_id]:::batch
      F6[fact_news_sentiment_daily<br/>MergeTree; partition tháng<br/>ORDER ticker, news_date]:::batch
    end

    subgraph CHAPP[APP & ALERT TABLES]
      direction LR
      F3[fact_alert_event<br/>MergeTree; partition tháng<br/>ORDER user_id, triggered_at]:::batch
      F4[fact_alert_rule_state<br/>ReplacingMergeTree<br/>ORDER alert_id, ticker]:::batch
    end

    subgraph CHSTREAM[STREAMING TABLES]
      direction LR
      K1["kafka_realtime_trade_ticks<br/>Kafka Engine (Đọc Tick)"]:::kafka
      K2["kafka_dnse_ohlcv_1m<br/>Kafka Engine (Đọc Nến)"]:::kafka
      R1[realtime_trade_ticks_raw<br/>MergeTree; partition ngày<br/>TTL 30 ngày]:::stream
      R2[fact_realtime_vwap_1m_state<br/>AggregatingMergeTree; partition ngày<br/>TTL 30 ngày]:::stream
      R3[fact_intraday_ohlcv<br/>ReplacingMergeTree; partition ngày<br/>TTL 30 ngày]:::stream
    end

    subgraph CHVIEW[LOGICAL AND MATERIALIZED VIEWS]
      direction LR
      MV1[mv_realtime_trade_ticks_raw<br/>Biến đổi dòng Tick]:::view
      MV2[mv_fact_realtime_vwap_1m_state<br/>Tổng hợp dòng VWAP]:::view
      MV3[mv_dnse_ohlcv_1m_fact<br/>Biến đổi dòng Nến]:::view
      V1[fact_realtime_vwap<br/>Chỉ số VWAP theo Phiên]:::view
      V2["fact_daily_price_indicators<br/>Chỉ báo Kỹ thuật (dbt)"]:::view
    end
  end

  subgraph PG[POSTGRESQL - DỮ LIỆU ỨNG DỤNG]
    direction LR
    P1[watchlist<br/>PK watchlist_id<br/>UNIQUE user_id, ticker]:::pg
    P2[user_alerts<br/>PK alert_id<br/>Rule, channel, cooldown]:::pg
  end

  subgraph CONSUMER[LỚP SỬ DỤNG]
    direction LR
    A1[FastAPI và React dashboard]:::app
    A2[Alert Engine<br/>Telegram và Email]:::app
    A3[Superset và Grafana]:::app
  end

  T1 --> K1
  T2 --> K2
  K1 --> MV1 --> R1
  K1 --> MV2 --> R2 --> V1
  K2 --> MV3 --> R3

  D3 -. sector_id logic .-> D2
  D2 -. ticker logic .-> F1
  D1 -. date_id logic .-> F1
  D4 -. index_id logic .-> F2
  D1 -. date_id logic .-> F2
  F1 --> V2
  D2 -. ticker logic .-> R3
  D2 -. ticker logic .-> V1
  F5 -->|ticker + ngày| F6
  P2 --> A2
  P1 --> A2
  V2 --> A2
  V1 --> A2
  A2 --> F3

  D1 --> A1
  D2 --> A1
  F1 --> A1
  F2 --> A1
  R3 --> A1
  V1 --> A1
  P1 --> A1
  P2 --> A1
  V2 --> A1
  F5 --> A1
  F6 --> A1
  F1 --> A3
  F2 --> A3
  F3 --> A3
  F6 --> A3

  style BUS fill:#FFFBEB,stroke:#D97706,color:#172033
  style CH fill:#F8FAFC,stroke:#2563EB,color:#172033
  style CHDIM fill:#FFFFFF,stroke:#94A3B8,color:#172033
  style CHBATCH fill:#FFFFFF,stroke:#94A3B8,color:#172033
  style CHSTREAM fill:#FFFFFF,stroke:#94A3B8,color:#172033
  style CHVIEW fill:#FFFFFF,stroke:#94A3B8,color:#172033
  style PG fill:#FFF7F8,stroke:#C43B55,color:#172033
  style CONSUMER fill:#F8FAFC,stroke:#64748B,color:#172033
