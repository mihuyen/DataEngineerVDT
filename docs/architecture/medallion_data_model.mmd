  subgraph S[SILVER - PARQUET TRÊN MINIO]
    direction TB
    S1V[ohlcv chuẩn hóa HOSE<br/>ticker, trading_date, open, high,<br/>low, close, volume, value<br/>Grain: ticker + trading_date<br/>Partition: year/month]:::silver
