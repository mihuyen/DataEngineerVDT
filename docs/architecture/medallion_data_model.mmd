    S5V[intraday OHLCV 1m<br/>ticker, minute_ts, trading_date,<br/>OHLC, volume, is_final, source<br/>Grain: ticker + minute_ts + source]:::silver
  end

  subgraph G[GOLD - PARQUET MINIO VÀ CLICKHOUSE]
    direction TB
    G1[dim_date, dim_stock,<br/>dim_sector, dim_index]:::gold
