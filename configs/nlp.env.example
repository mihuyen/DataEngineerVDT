# Public general-domain baseline. Replace it after fine-tuning on financial news.
HF_MODEL_REPO=wonrax/phobert-base-vietnamese-sentiment
HF_TOKEN=
MODEL_VERSION=wonrax-phobert-general-baseline

# These models are unnecessary while the project only processes financial news.
LOAD_SOCIAL_MODEL=false
LOAD_TOPIC_MODEL=false

# Used by local Python jobs. Airflow should use http://nlp-service:8000.
NLP_SERVICE_URL=http://localhost:8002
